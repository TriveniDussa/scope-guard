# Scope Guard Backend Environment Configuration

# Database: PostgreSQL (Supabase or local PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# For Supabase, copy the URI from Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql+psycopg2://postgres:your_supabase_password@db.your_project_ref.supabase.co:5432/postgres

# JWT Authentication
# Generate a secure 32+ byte hex key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=scopeguard_super_secret_jwt_key_change_in_production_2026_x7a8b9c0
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment: development | production | test
ENVIRONMENT=development

# CORS Allowed Origins (comma-separated, add your deployed frontend domain)
CORS_ORIGINS=https://YOUR-FRONTEND-URL.vercel.app,http://localhost:5173,http://localhost:3000

# AI Scope Guard Configuration
# Supported AI_PROVIDER values: "gemini" (default) or "openai"
# Current Google Gemini production model: gemini-2.5-flash
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional if using OpenAI provider)
OPENAI_API_KEY=your_openai_api_key_here

